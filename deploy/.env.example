# Salin ke .env untuk uji Docker Compose lokal, atau isi di tab Environment Dokploy.
# Kredensial ini dibuat untuk database baru; simpan salinannya di tempat aman.
POSTGRES_DB=hadir
POSTGRES_USER=hadir
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
# Wajib diganti. Compose tidak bisa membandingkan nilai, jadi API menolak start bila nilai tetap REPLACE_WITH_*.
# Buat dengan: openssl rand -base64 32 | tr -d "/+="
