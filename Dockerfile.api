FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags="-s -w" -o /out/hadir ./cmd/hadir

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata && addgroup -S hadir && adduser -S -G hadir hadir
WORKDIR /app
COPY --from=build /out/hadir /app/hadir
COPY deploy/api-entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh
USER hadir:hadir
EXPOSE 8080
ENTRYPOINT ["/app/entrypoint.sh"]
